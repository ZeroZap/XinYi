# Kconfig for XY sensor Component

config XY_SENSOR_ENABLE
    bool "sensor component support"
    default y
    select COMPONENT_DEVICE
    help
      Enable support for the sensor component.
      This component provides sensor drivers.

      The canonical drivers this component links reach the bus through the
      Device framework, so `COMPONENT_DEVICE` is not optional. The relation is
      declared in the root `Kconfig` too, because that is the only file
      `cmake/kconfig_parser.py` reads; this fragment is documentation and
      `check_kconfig_fragment_agreement.py` fails if the two disagree.

if XY_SENSOR_ENABLE

config XY_SENSOR_TEST
    bool "Enable sensor component tests"
    default y
    depends on XY_SENSOR_ENABLE
    help
      Enable unit tests for the sensor component.

config XY_SENSOR_EXAMPLE
    bool "Enable sensor component examples"
    default y
    depends on XY_SENSOR_ENABLE
    help
      Enable example applications for the sensor component.

endif # XY_SENSOR_ENABLE

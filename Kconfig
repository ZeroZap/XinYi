source "third_party/Kconfig"
endif

# ==================== Build Configuration ====================

menu "Build Options"
    config BUILD_TESTING
        bool "Build tests"
        default n
        help
          Enable building of unit tests.

    config BUILD_SHARED_LIBS
        bool "Build shared libraries"
        default n
        help
          Build shared libraries instead of static.

    config ENABLE_LOGGING
        bool "Enable logging"
        default y
        help
          Enable framework logging.

    config ENABLE_ASSERTIONS
        bool "Enable assertions"
        default y
        help
          Enable runtime assertions.
endmenu

endmenu

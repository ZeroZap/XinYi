# Top-level Kconfig for XY Framework

menu "XY Framework Configuration"

config XY_FRAMEWORK_VERSION
    string "XY Framework Version"
    default "1.0.0"
    help
      The version of the XY Framework being used.

# ==================== Core Components ====================

source "components/crypto/Kconfig"
source "components/clib/xy_clib/Kconfig"
source "components/dm/Kconfig"
source "components/net/Kconfig"
source "components/trace/Kconfig"

# ==================== Kernel & OS ====================

source "components/kernel/osal/Kconfig"
source "components/kernel/misc/Kconfig"


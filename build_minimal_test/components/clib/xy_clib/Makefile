	cd /home/eugene/zerozap/XinYi/build_minimal_test && $(MAKE) $(MAKESILENT) -f components/clib/xy_clib/CMakeFiles/xy_xy_clib.dir/build.make components/clib/xy_clib/CMakeFiles/xy_xy_clib.dir/xy_string.c.s
.PHONY : xy_string.c.s

